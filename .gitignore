# --- Pensieve gitignore ---

# Secrets / env
.env
.env.local

# Local data store (SQLite + samples drafts + sync state)
data/*.db
data/*.db-*
data/sync_state.json

# Local reflections (markdown exports may contain sensitive impact statements)
data/reflections/
data/vials/

# Logs
logs/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/

# Node / Vite
node_modules/
dist/
.vite/

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Pensieve runtime artifacts
data/audit-log.jsonl
data/enriched*.json
data/chroma/
data/notes-backups/

# Recap run history + in-app docs (user content, may be sensitive)
data/recaps/
data/ai-models.json
data/connections.json
data/ms-token-cache.bin*
data/personal-graph-token-cache.bin*
data/docs/

# Garden runtime state (achievements, daily quests) + store backups
data/achievements.json
data/garden-quests.json
data/chroma.bak*/

# Local editor / preview config
.claude/settings.local.json


# Desktop launcher build intermediates (desktop/dist is covered by dist/ above)
desktop/obj/

# setuptools build output (pip install of the repo)
/build/

# Generated by desktop/installer/build-installer.ps1
frontend-proto/third-party-notices.txt
