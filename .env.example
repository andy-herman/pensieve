# Azure OpenAI (Cortex hub, keyless via DefaultAzureCredential)
# These must mirror the corresponding values in your Inbox Copilot / Argus / Synapse .env
# so the same `az login` session works for all of them.

AZURE_OPENAI_ENDPOINT=https://agents-wus3-02.services.ai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-2
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_TOKEN_SCOPE=https://ai.azure.com/.default

# Optional API-key fallback (overrides DefaultAzureCredential when set).
# Leave commented to use the AAD bearer path.
# AZURE_OPENAI_API_KEY=...

# --- Pensieve runtime tuning ---
PENSIEVE_DATA_DIR=./data
PENSIEVE_BACKEND_PORT=8765
PENSIEVE_ENRICHMENT_CONFIDENCE_THRESHOLD=0.6
PENSIEVE_DEFAULT_LIST_NAME=Tasks

# --- Connect recap source-list filter ---
# Comma-separated list of source list_name values to INCLUDE when generating
# a Connect recap. Tasks in lists not on this allowlist (e.g. "home", "UW
# Lectures") are filtered out before the LLM call so personal/non-work tasks
# never end up in your work recap. Leave blank to disable the filter (include
# every list). Per-call API override: POST /api/recap body field `list_names`.
PENSIEVE_RECAP_LIST_NAMES=CISO GRC

# --- Phase 1: ChromaDB + sources ---
# Source for `pensieve sync` when --source is not specified:
#   sample_file  - reads data/samples.json (Phase 0 / tests / offline)
#   outlook_com  - reads the running Outlook desktop client (READ-ONLY, no writeback)
PENSIEVE_DEFAULT_SOURCE=sample_file

# How long to keep completed Outlook tasks in the enrichment queue.
PENSIEVE_OUTLOOK_SKIP_COMPLETED_OLDER_DAYS=30

# --- Mirror tag (Phase 2 TaskSink writeback) ---
# When true, dragging a card in the kanban writes a `pensieve/col:<col>` tag
# back to the source task's Categories field (Outlook COM only for now). A
# second PC syncing the same Microsoft To-Do account then sees the same
# kanban view. Pensieve only ever touches categories that start with the
# prefix below; every other Categories value is preserved byte for byte.
# Default off until you verify on at least one machine.
PENSIEVE_MIRROR_TO_SOURCE=false
PENSIEVE_MIRROR_TAG_PREFIX=pensieve/col:

# When true, dragging a card to the `closed` column marks the source task
# complete in Outlook via TaskItem.MarkComplete(). v1 is one-way (close only):
# dragging OUT of `closed` does NOT reopen the source. If you reopen in
# Outlook the next auto-sync (see below) moves the card back to `memory`
# automatically. This is a SEPARATE flag from PENSIEVE_MIRROR_TO_SOURCE
# because completion is a higher-impact write than a category tag (visible
# to delegates, propagates to shared lists). Default off.
PENSIEVE_MIRROR_COMPLETION=false

# --- Auto-sync scheduler ---
# The backend periodically calls the same code path as `POST /api/sync` so
# the dashboard stays current without manual "Pull from To-Do" clicks. Set
# to 0 to disable. Reasonable values: 60-300 seconds. Manual and scheduled
# syncs share the same single-job lock, so they never collide on Chroma.
PENSIEVE_AUTO_SYNC_INTERVAL_SECONDS=120
# Source the scheduler should sync from. Leave blank to use
# PENSIEVE_DEFAULT_SOURCE. Set to `outlook_com` if your default source is
# `sample_file` (auto-syncing a static JSON fixture is pointless, so those
# ticks are silently skipped).
PENSIEVE_AUTO_SYNC_SOURCE=

# Where Chroma persists its embedded store (relative to data_dir).
PENSIEVE_CHROMA_DIR_NAME=chroma

# Enrichment caps
PENSIEVE_ENRICHMENT_MAX_TOKENS=1500
PENSIEVE_ENRICHMENT_CONCURRENCY=3

# CORS allow-list for the local FastAPI server (comma-separated).
# `null` lets file://-opened HTML pages talk to the API.
PENSIEVE_API_CORS_ORIGINS=http://localhost:8765,http://127.0.0.1:8765,null

# --- Microsoft Graph (DEFERRED) ---
# Phase 1 is pull-only via Outlook COM. Graph integration is deferred until
# Microsoft's Secure Future Initiative (SFI) admin-consent path is sorted.
# See PHASES.md and OPEN-QUESTIONS.md Q1 for the current status.
# PENSIEVE_GRAPH_CLIENT_ID=<your-app-id>
# PENSIEVE_GRAPH_TENANT_ID=72f988bf-86f1-41af-91ab-2d7cd011db47
