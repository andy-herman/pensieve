# Azure OpenAI (Cortex hub, keyless via DefaultAzureCredential)
# These must mirror the corresponding values in your Inbox Copilot / Argus / Synapse .env
# so the same `az login` session works for all of them.

AZURE_OPENAI_ENDPOINT=https://agents-wus3-02.services.ai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-2
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_TOKEN_SCOPE=https://ai.azure.com/.default

# Microsoft Graph (Phase 1+; unused in Phase 0)
# Pick ONE of these auth paths based on the Graph unblock decision (see OPEN-QUESTIONS.md Q1):
#
# Path A: Custom Entra app registration (long-term)
# PENSIEVE_GRAPH_CLIENT_ID=<your-app-id>
# PENSIEVE_GRAPH_TENANT_ID=72f988bf-86f1-41af-91ab-2d7cd011db47
#
# Path B: Azure CLI token (interim, if Tasks.ReadWrite is pre-consented)
# PENSIEVE_GRAPH_USE_AZ_CLI=true

# Pensieve runtime tuning
PENSIEVE_ENRICHMENT_CONFIDENCE_THRESHOLD=0.6
PENSIEVE_DEFAULT_LIST_NAME=Tasks
PENSIEVE_BACKEND_PORT=8440
PENSIEVE_DATA_DIR=./data
